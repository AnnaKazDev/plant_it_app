---
import type { User } from "@supabase/supabase-js";
import HomeBackground from "@/components/home/HomeBackground.astro";
import NavIcon from "@/components/NavIcon.astro";
import PlantItLogo from "@/components/PlantItLogo.astro";

interface Props {
  user: User;
  plantCount: number;
}

const { user, plantCount } = Astro.props;
const emailInitial = user.email?.[0]?.toUpperCase() ?? "?";
---

<HomeBackground>
  <div class="relative z-10 px-4 sm:px-8">
    <div
      class="mx-auto flex max-w-4xl flex-col items-center px-4 pt-16 pb-10 text-center sm:pt-20 sm:pb-12"
    >
      <PlantItLogo class="mb-6 h-auto w-full max-w-[240px]" />
      <h1
        class="from-primary via-secondary to-accent mb-3 bg-gradient-to-r bg-clip-text text-4xl leading-tight font-bold sm:text-5xl"
      >
        {plantCount === 0 ? "Your garden awaits" : "Welcome back, Gardener"}
      </h1>
      <p class="text-muted-foreground max-w-2xl text-base sm:text-lg">
        Your little patch of earth, organized. Name your plants, pin them on your garden map, snap their
        growth, and remember every watering, prune, and sunny day.
      </p>
    </div>

    <div
      class="border-border bg-card/50 mx-auto mb-16 w-full max-w-lg rounded-2xl border p-6 backdrop-blur-xl sm:p-8"
    >

      {
        plantCount === 0 ? (
          <div class="text-center">
            <p class="text-foreground font-medium">Your garden is empty</p>
            <p class="text-muted-foreground mt-1 text-sm">
              Start with one plant and pin it on the map.
            </p>
          </div>
        ) : (
          <div class="text-center">
            <p class="text-foreground text-4xl font-bold tabular-nums">{plantCount}</p>
            <p class="text-muted-foreground text-sm">
              plant{plantCount === 1 ? "" : "s"} in your garden
            </p>
            <p class="text-muted-foreground mt-2 text-sm">Nice work — keep tending your patch.</p>
          </div>
        )
      }

      <div class="border-border/60 my-5 border-t" />


      <div class="flex flex-col gap-3">
        <a
          href="/plants/new"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors"
        >
          <NavIcon name="plus" />
          {plantCount === 0 ? "Plant your first one" : "Add another plant"}
        </a>
        {
          plantCount > 0 ? (
            <>
              <a
                href="/plants"
                class="border-border bg-muted hover:bg-muted/80 inline-flex w-full items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium transition-colors"
              >
                <NavIcon name="plants" />
                See your plant list
              </a>
              <a
                href="/garden-map"
                class="border-border bg-muted hover:bg-muted/80 inline-flex w-full items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium transition-colors"
              >
                <NavIcon name="map" />
                Wander the garden map
              </a>
            </>
          ) : null
        }
      </div>
    </div>
  </div>
</HomeBackground>
