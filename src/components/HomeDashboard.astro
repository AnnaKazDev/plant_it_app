---
import type { User } from "@supabase/supabase-js";
import NavIcon from "@/components/NavIcon.astro";
import PlantItLogo from "@/components/PlantItLogo.astro";

interface Props {
  user: User;
  plantCount: number;
}

const { user, plantCount } = Astro.props;
---

<div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
  <div class="border-border bg-card/50 w-full max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl">
    <PlantItLogo class="mx-auto mb-4 h-auto w-full max-w-[220px]" />
    <p class="text-muted-foreground">
      Welcome, <span class="text-foreground font-semibold">{user.email}</span>
    </p>

    {
      plantCount === 0 ? (
        <p class="text-muted-foreground mt-4 text-sm">
          You have no plants yet. Add your first one to start tracking.
        </p>
      ) : (
        <p class="text-muted-foreground mt-4 text-sm">
          You are tracking {plantCount} plant{plantCount === 1 ? "" : "s"}.
        </p>
      )
    }

    <div class="mt-6 flex flex-col items-center gap-3">
      {
        plantCount > 0 ? (
          <>
            <a
              href="/plants"
              class="border-border bg-muted hover:bg-muted/80 inline-flex w-full items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium transition-colors"
            >
              <NavIcon name="plants" />
              View my plants
            </a>
            <a
              href="/garden-map"
              class="border-border bg-muted hover:bg-muted/80 inline-flex w-full items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium transition-colors"
            >
              <NavIcon name="map" />
              View garden map
            </a>
          </>
        ) : null
      }
      <a
        href="/plants/new"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors"
      >
        <NavIcon name="plus" />
        {plantCount === 0 ? "Add your first plant" : "Add another plant"}
      </a>
    </div>
  </div>
</div>
