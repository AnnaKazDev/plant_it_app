---
import { formatWeatherSummary, getWeatherDetailLines } from "@/lib/weather-display";
import type { WeatherData } from "@/types";

interface Props {
  weather: WeatherData | null;
  showSummary?: boolean;
}

const { weather, showSummary = true } = Astro.props;
const details = getWeatherDetailLines(weather);
const iconClass = "size-3 shrink-0";
---

<div class="space-y-1">
  {showSummary ? <p class="text-muted-foreground text-sm">{formatWeatherSummary(weather)}</p> : null}
  {
    details.length > 0 ? (
      <ul class="text-muted-foreground flex flex-wrap gap-x-3 gap-y-1 text-xs">
        {details.map((detail) => (
          <li class="inline-flex items-center gap-1">
            {detail.icon === "droplets" ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class:list={iconClass}
                aria-hidden="true"
              >
                <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.52-2.26-1.28-3.21-.74-.9-1.64-1.98-2.26-3.21-.72-1.22-1.28-2.44-1.28-3.79C4.99 1.75 6.78 1 8.5 1c1.04 0 2.05.34 2.9.97" />
                <path d="M12.66 4.13c.8-1.04 2.04-1.63 3.34-1.63 2.21 0 4 1.79 4 4 0 1.35-.56 2.57-1.28 3.79-.62 1.23-1.52 2.31-2.26 3.21-.76.95-1.28 2.05-1.28 3.21 0 2.22 1.8 4.05 4 4.05s4-1.83 4-4.05c0-1.16-.52-2.26-1.28-3.21-.74-.9-1.64-1.98-2.26-3.21-.72-1.22-1.28-2.44-1.28-3.79 0-1.75 1.79-2.5 3.51-2.5.76 0 1.5.2 2.16.55" />
              </svg>
            ) : detail.icon === "wind" ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class:list={iconClass}
                aria-hidden="true"
              >
                <path d="M12.8 19.6A2 2 0 1 0 14 16H2" />
                <path d="M17.5 8a2.5 2.5 0 1 1 2 4H2" />
                <path d="M9.8 6.4A2 2 0 1 1 11 12H2" />
              </svg>
            ) : detail.icon === "moon" ? (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class:list={iconClass}
                aria-hidden="true"
              >
                <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
              </svg>
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class:list={iconClass}
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2" />
                <path d="M12 20v2" />
                <path d="m4.93 4.93 1.41 1.41" />
                <path d="m17.66 17.66 1.41 1.41" />
                <path d="M2 12h2" />
                <path d="M20 12h2" />
                <path d="m6.34 17.66-1.41 1.41" />
                <path d="m19.07 4.93-1.41 1.41" />
              </svg>
            )}
            {detail.label}
          </li>
        ))}
      </ul>
    ) : null
  }
</div>
