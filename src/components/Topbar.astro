---
import { ThemeToggle } from "@/components/ThemeToggle";

const { user } = Astro.locals;
---

<div
  class="border-border bg-card/50 text-muted-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm"
>
  {
    user ? (
      <>
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="hover:text-primary/80 text-primary transition-colors hover:underline">
            Dashboard
          </a>
          <form method="POST" action="/api/auth/signout" class="inline">
            <button type="submit" class="hover:text-primary/80 text-primary transition-colors hover:underline">
              Sign out
            </button>
          </form>
          <span class="h-4 border border-l" />
          <ThemeToggle client:load />
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Not signed in</span>
        <div class="flex items-center gap-3">
          <a href="/auth/signin" class="hover:text-primary/80 text-primary transition-colors hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="hover:text-primary/80 text-primary transition-colors hover:underline">
            Sign up
          </a>
          <span class="h-4 border border-l" />
          <ThemeToggle client:load />
        </div>
      </>
    )
  }
</div>
