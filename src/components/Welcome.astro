---
import HomeBackground from "@/components/home/HomeBackground.astro";
import HomeFeatureCards from "@/components/home/HomeFeatureCards.astro";
import PlantItLogo from "@/components/PlantItLogo.astro";
---

<HomeBackground>
  <div class="relative z-10 px-4 sm:px-8">
    <div
      class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40"
    >
      <PlantItLogo class="mb-6 h-auto w-full max-w-[240px]" />
      <p class="text-muted-foreground mb-10 max-w-2xl sm:text-xl">
        Your little patch of earth, organized. Name your plants, pin them on your garden map, snap their
        growth, and remember every watering, prune, and sunny day.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signup"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
        >
          Start your garden
        </a>
        <a
          href="/auth/signin"
          class="bg-secondary text-secondary-foreground hover:bg-secondary/80 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium shadow-xs transition-colors"
        >
          Welcome back, Gardener
        </a>
      </div>
    </div>

    <div class="pb-24">
      <HomeFeatureCards />
    </div>
  </div>
</HomeBackground>
