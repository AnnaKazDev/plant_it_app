---

---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <!-- Cosmic orbs - using theme colors -->
  <div
    class="bg-primary/20 pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full blur-[120px]"
  >
  </div>
  <div
    class="bg-secondary/15 pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full blur-[100px]"
  >
  </div>
  <div
    class="bg-accent/10 pointer-events-none absolute top-0 left-1/2 h-[300px] w-[300px] -translate-x-1/2 rounded-full blur-[140px]"
  >
  </div>

  <!-- Star field - subtle pattern using theme colors -->
  <div
    class="pointer-events-none absolute inset-0 opacity-30"
    style="background-image: radial-gradient(circle, var(--foreground) 1px, transparent 1px); background-size: 150px 150px; background-position: 0 0;"
  >
  </div>

  <div class="relative z-10 px-4 sm:px-8">
    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1
        class="from-primary via-secondary to-accent mb-6 bg-gradient-to-r bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl lg:text-7xl"
      >
        10x Astro Starter :)
      </h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        A production-ready starter with authentication, modern tooling, and a cosmic developer experience.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
        >
          Sign In
        </a>
        <a
          href="/auth/signup"
          class="border-border text-foreground hover:bg-muted/50 inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
        >
          Sign Up
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="border-border bg-card/50 rounded-xl border p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Authentication Ready</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Built-in Supabase auth with sign in, sign up, and protected routes out of the box.
        </p>
      </div>

      <div class="border-border bg-card/50 rounded-xl border p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Modern Stack</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Astro 5, React 19, Tailwind 4, and TypeScript — the latest tools, ready to go.
        </p>
      </div>

      <div class="border-border bg-card/50 rounded-xl border p-6 backdrop-blur-xl">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <h3 class="text-foreground mb-2 text-lg font-semibold">Developer Experience</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          ESLint, Prettier, and pre-commit hooks keep your codebase clean from day one.
        </p>
      </div>
    </div>
  </div>
</div>
