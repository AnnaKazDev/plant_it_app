---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in - Plant It App">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card/50 w-full max-w-sm rounded-2xl border p-8 backdrop-blur-xl">
      <h1
        class="from-primary to-secondary mb-6 bg-gradient-to-r bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Sign in
      </h1>
      <SignInForm serverError={error} client:only="react" />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-primary hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
