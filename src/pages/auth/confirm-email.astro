---
import Layout from "@/layouts/Layout.astro";

const reason = Astro.url.searchParams.get("reason");
const isAutoConfirmed = import.meta.env.DEV;

type ConfirmEmailContent = {
  emoji: string;
  heading: string;
  description: string;
  buttonText: string;
};

const contentByReason: Record<string, ConfirmEmailContent> = {
  pending: {
    emoji: "📧",
    heading: "Check your email",
    description:
      "Your account may already be registered. We sent a confirmation link to your inbox — click it to activate your account, then sign in. If you don't see the email, check spam or wait a few minutes before trying again.",
    buttonText: "Go to sign in",
  },
  unconfirmed: {
    emoji: "📧",
    heading: "Confirm your email first",
    description:
      "Your account exists but is not active yet. Open the confirmation link we sent to your email, then come back here to sign in.",
    buttonText: "Go to sign in",
  },
};

const defaultProduction: ConfirmEmailContent = {
  emoji: "📧",
  heading: "Registration successful",
  description:
    "We've sent a confirmation link to your email address. Click it to activate your account, then sign in.",
  buttonText: "Go to sign in",
};

const defaultDev: ConfirmEmailContent = {
  emoji: "✅",
  heading: "Registration successful",
  description: "Your account has been created. You can now sign in.",
  buttonText: "Go to sign in",
};

const content =
  reason && contentByReason[reason]
    ? contentByReason[reason]
    : isAutoConfirmed
      ? defaultDev
      : defaultProduction;
---

<Layout title={content.heading}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card/50 w-full max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl">
      <div class="mb-4 text-5xl" aria-hidden="true">{content.emoji}</div>
      <h1 class="from-primary to-secondary mb-3 bg-gradient-to-r bg-clip-text text-2xl font-bold">
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-8 text-sm leading-relaxed">{content.description}</p>
      <a
        href="/auth/signin"
        class="bg-primary text-primary-foreground inline-flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium shadow-xs hover:bg-primary/90"
      >
        {content.buttonText}
      </a>
    </div>
  </div>
</Layout>
