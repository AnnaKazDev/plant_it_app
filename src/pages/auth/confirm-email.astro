---
import Layout from "@/layouts/Layout.astro";

const reason = Astro.url.searchParams.get("reason");
const isAutoConfirmed = import.meta.env.DEV;

interface ConfirmEmailContent {
  emoji: string;
  heading: string;
  description: string;
  buttonText: string;
}

const contentByReason: Record<string, ConfirmEmailContent> = {
  pending: {
    emoji: "📧",
    heading: "Account may already exist",
    description:
      "If you registered before, check your inbox for the confirmation link or try signing in. We do not send another confirmation email for duplicate sign-up attempts. Check spam or wait a few minutes if you registered recently.",
    buttonText: "Go to sign in",
  },
  setup_pending: {
    emoji: "📧",
    heading: "Registration successful",
    description:
      "Your account was created and we sent a confirmation link to your email. After confirming, sign in and complete your garden setup to start adding plants.",
    buttonText: "Go to sign in",
  },
  unconfirmed: {
    emoji: "📧",
    heading: "Confirm your email first",
    description:
      "Your account exists but is not active yet. Open the confirmation link we sent to your email, then come back here to sign in.",
    buttonText: "Go to sign in",
  },
};

const defaultProduction: ConfirmEmailContent = {
  emoji: "📧",
  heading: "Registration successful",
  description: "We've sent a confirmation link to your email address. Click it to activate your account, then sign in.",
  buttonText: "Go to sign in",
};

const defaultDev: ConfirmEmailContent = {
  emoji: "✅",
  heading: "Registration successful",
  description: "Your account has been created. You can now sign in.",
  buttonText: "Go to sign in",
};

const signInHref = reason === "setup_pending" ? "/auth/signin?next=%2Fgarden%2Fsetup" : "/auth/signin";
const content =
  reason !== null && reason in contentByReason
    ? contentByReason[reason]
    : isAutoConfirmed
      ? defaultDev
      : defaultProduction;
---

<Layout title={content.heading}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card/50 w-full max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl">
      <div class="mb-4 text-5xl" aria-hidden="true">{content.emoji}</div>
      <h1 class="from-primary to-secondary mb-3 bg-gradient-to-r bg-clip-text text-2xl font-bold">
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-8 text-sm leading-relaxed">{content.description}</p>
      <a
        href={signInHref}
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium shadow-xs"
      >
        {content.buttonText}
      </a>
    </div>
  </div>
</Layout>
