---
import Layout from "@/layouts/Layout.astro";
import AddPlantForm from "@/components/plants/AddPlantForm";
import { loadAddPlantPageData } from "@/lib/plant-page";

const { user } = Astro.locals;
const pageData = user
  ? await loadAddPlantPageData(Astro.request.headers, Astro.cookies, user.id)
  : { gardenWidth: 0, gardenHeight: 0, hasGardenSetup: false, plants: [] };
---

<Layout title="Add new plant - Plant It App">
  <div class="bg-cosmic flex min-h-screen justify-center p-4 pt-8">
    <div class="border-border bg-card/50 w-full max-w-4xl rounded-2xl border p-8 backdrop-blur-xl">
      {
        !user ? (
          <div class="space-y-4 text-center">
            <h1 class="text-foreground text-2xl font-bold">Who&apos;s gardening here?</h1>
            <p class="text-muted-foreground text-sm">
              <a href="/auth/signin" class="text-primary hover:underline">
                Sign in
              </a>{" "}
              first — then we&apos;ll get you planting.
            </p>
          </div>
        ) : !pageData.hasGardenSetup ? (
          <div class="space-y-4 text-center">
            <h1 class="text-foreground text-2xl font-bold">Your plot needs a size first</h1>
            <p class="text-muted-foreground text-sm">
              Tell us how big your garden is — then your plants can move in.
            </p>
            <a
              href="/auth/signup"
              class="bg-primary text-primary-foreground inline-flex rounded-md px-4 py-2 text-sm font-medium"
            >
              Finish garden setup
            </a>
          </div>
        ) : (
          <div>
            <h1 class="from-primary to-secondary mb-2 bg-gradient-to-r bg-clip-text text-2xl font-bold">
              Add new plant
            </h1>
            <p class="text-muted-foreground mb-6 text-sm">
              Name it, snap a pic if you&apos;re feeling photogenic, then drop it on your garden map. Enjoy!
            </p>
            <AddPlantForm
              gardenWidth={pageData.gardenWidth}
              gardenHeight={pageData.gardenHeight}
              gardenName={pageData.gardenName}
              existingPlants={pageData.plants}
              client:only="react"
            />
          </div>
        )
      }
    </div>
  </div>
</Layout>
