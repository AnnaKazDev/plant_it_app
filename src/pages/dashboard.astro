---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

let plantCount = 0;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const { count } = await supabase.from("plants").select("*", { count: "exact", head: true }).eq("user_id", user.id);
    plantCount = count ?? 0;
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card/50 w-full max-w-md rounded-2xl border p-8 text-center backdrop-blur-xl">
      <h1 class="from-primary to-secondary mb-4 bg-gradient-to-r bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-muted-foreground">
        Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
      </p>

      {
        plantCount === 0 ? (
          <p class="text-muted-foreground mt-4 text-sm">
            You have no plants yet. Add your first one to start tracking.
          </p>
        ) : (
          <p class="text-muted-foreground mt-4 text-sm">
            You are tracking {plantCount} plant{plantCount === 1 ? "" : "s"}.
          </p>
        )
      }

      <div class="mt-6 flex flex-col items-center gap-3">
        <a
          href="/plants/new"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors"
        >
          {plantCount === 0 ? "Add your first plant" : "Add another plant"}
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="border-border bg-muted hover:bg-muted/80 rounded-lg border px-4 py-2 text-sm transition-colors"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
