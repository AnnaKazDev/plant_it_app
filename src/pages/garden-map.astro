---
import Layout from "@/layouts/Layout.astro";
import NavIcon from "@/components/NavIcon.astro";
import GardenMapContextBar from "@/components/plants/GardenMapContextBar.astro";
import GardenMapView from "@/components/plants/GardenMapView";
import { loadGardenMapPageData } from "@/lib/plant-page";

const { user } = Astro.locals;
const pageData = user
  ? await loadGardenMapPageData(Astro.request.headers, Astro.cookies, user.id)
  : { gardenWidth: 0, gardenHeight: 0, hasGardenSetup: false, plants: [] };
---

<Layout title="Garden map - Plant It App">
  <div class="bg-cosmic flex min-h-screen justify-center p-3 sm:p-4 sm:pt-8">
    <div class="border-border bg-card/50 w-full max-w-4xl rounded-2xl border p-4 backdrop-blur-xl sm:p-6 lg:p-8">
      {
        !user ? (
          <div class="space-y-4 text-center">
            <h1 class="text-foreground text-2xl font-bold">Sign in required</h1>
            <p class="text-muted-foreground text-sm">
              <a href="/auth/signin" class="text-primary hover:underline">
                Sign in
              </a>{" "}
              to view your garden map.
            </p>
          </div>
        ) : !pageData.hasGardenSetup ? (
          <div class="space-y-4 text-center">
            <h1 class="text-foreground text-2xl font-bold">Garden setup required</h1>
            <p class="text-muted-foreground text-sm">
              Complete registration with garden dimensions before viewing the map.
            </p>
            <a
              href="/garden/setup?next=%2Fgarden-map"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex rounded-md px-4 py-2 text-sm font-medium"
            >
              Complete setup
            </a>
          </div>
        ) : pageData.plants.length === 0 ? (
          <div class="space-y-4 lg:space-y-6">
            <div class="space-y-3 lg:space-y-4">
              <div class="flex flex-wrap items-start justify-between gap-2 lg:gap-3">
                <div class="max-w-2xl">
                  <h1 class="from-primary to-secondary bg-gradient-to-r bg-clip-text text-xl font-bold lg:text-2xl">
                    Garden map
                  </h1>
                  <p class="text-muted-foreground mt-1 text-xs leading-snug lg:mt-2 lg:text-sm">
                    Your grid is ready and waiting. Add a plant, pin it here, and this map will start to tell your
                    garden&apos;s story.
                  </p>
                </div>
                <a
                  href="/plants/new"
                  class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex shrink-0 items-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors"
                >
                  <NavIcon name="plus" />
                  Add new plant
                </a>
              </div>

              <GardenMapContextBar
                locationCity={pageData.locationCity}
                gardenName={pageData.gardenName}
                gardenWidth={pageData.gardenWidth}
                gardenHeight={pageData.gardenHeight}
                plantCount={0}
                todayWeather={pageData.todayWeather}
              />
            </div>
          </div>
        ) : (
          <div>
            <div class="mb-4 space-y-3 lg:mb-6 lg:space-y-4">
              <div class="flex flex-wrap items-start justify-between gap-2 lg:gap-3">
                <div class="max-w-2xl">
                  <h1 class="from-primary to-secondary bg-gradient-to-r bg-clip-text text-xl font-bold lg:text-2xl">
                    Garden map
                  </h1>
                  <p class="text-muted-foreground mt-1 text-xs leading-snug lg:mt-2 lg:text-sm">
                    A bird&apos;s-eye view of your patch. Each pin marks a plant you&apos;ve placed on the grid — hover
                    for a quick peek at their latest action, then click through for the full story.
                  </p>
                </div>
                <a
                  href="/plants/new"
                  class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex shrink-0 items-center gap-2 rounded-md px-3 py-1.5 text-sm font-medium transition-colors lg:px-4 lg:py-2"
                >
                  <NavIcon name="plus" />
                  Add new plant
                </a>
              </div>

              <GardenMapContextBar
                locationCity={pageData.locationCity}
                gardenName={pageData.gardenName}
                gardenWidth={pageData.gardenWidth}
                gardenHeight={pageData.gardenHeight}
                plantCount={pageData.plants.length}
                todayWeather={pageData.todayWeather}
              />
            </div>
            <GardenMapView
              gardenWidth={pageData.gardenWidth}
              gardenHeight={pageData.gardenHeight}
              plants={pageData.plants}
              client:only="react"
            />
          </div>
        )
      }
    </div>
  </div>
</Layout>
