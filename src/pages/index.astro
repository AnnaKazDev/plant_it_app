---
import Welcome from "@/components/Welcome.astro";
import HomeDashboard from "@/components/HomeDashboard.astro";
import Layout from "@/layouts/Layout.astro";
import { getUserPlantCount } from "@/lib/plants";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

let plantCount = 0;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    plantCount = await getUserPlantCount(supabase, user.id);
  }
}
---

<Layout title="Plant It App">
  {user ? <HomeDashboard user={user} plantCount={plantCount} /> : <Welcome />}
</Layout>
