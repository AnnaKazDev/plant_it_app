---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { ThemeToggle } from "@/components/ThemeToggle";
---

<Layout title="Theme Preview">
  <div class="bg-background min-h-screen p-8">
    <div class="mx-auto max-w-4xl space-y-12">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-foreground mb-2 text-4xl font-bold">Theme Preview - Sage Green</h1>
          <p class="text-muted-foreground">Nowy theme z tweakcn w formacie OKLCH</p>
        </div>
        <ThemeToggle client:load />
      </div>

      <!-- Colors Grid -->
      <div class="space-y-4">
        <h2 class="text-foreground text-2xl font-semibold">Kolory</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
          <div class="space-y-2">
            <div class="bg-primary h-20 rounded-lg"></div>
            <p class="text-foreground text-sm">Primary</p>
          </div>
          <div class="space-y-2">
            <div class="bg-secondary h-20 rounded-lg"></div>
            <p class="text-foreground text-sm">Secondary</p>
          </div>
          <div class="space-y-2">
            <div class="bg-accent h-20 rounded-lg"></div>
            <p class="text-foreground text-sm">Accent</p>
          </div>
          <div class="space-y-2">
            <div class="bg-muted h-20 rounded-lg"></div>
            <p class="text-foreground text-sm">Muted</p>
          </div>
          <div class="space-y-2">
            <div class="bg-destructive h-20 rounded-lg"></div>
            <p class="text-foreground text-sm">Destructive</p>
          </div>
          <div class="space-y-2">
            <div class="border-border bg-card h-20 rounded-lg border-2"></div>
            <p class="text-foreground text-sm">Card</p>
          </div>
          <div class="space-y-2">
            <div class="border-border bg-popover h-20 rounded-lg border-2"></div>
            <p class="text-foreground text-sm">Popover</p>
          </div>
          <div class="space-y-2">
            <div class="bg-input border-border h-20 rounded-lg border-2"></div>
            <p class="text-foreground text-sm">Input</p>
          </div>
        </div>
      </div>

      <!-- Buttons -->
      <div class="space-y-4">
        <h2 class="text-foreground text-2xl font-semibold">Przyciski</h2>
        <div class="flex flex-wrap gap-4">
          <Button client:load>Default Button</Button>
          <Button client:load variant="secondary">Secondary</Button>
          <Button client:load variant="outline">Outline</Button>
          <Button client:load variant="ghost">Ghost</Button>
          <Button client:load variant="destructive">Destructive</Button>
          <Button client:load variant="link">Link</Button>
        </div>
      </div>

      <!-- Cards -->
      <div class="space-y-4">
        <h2 class="text-foreground text-2xl font-semibold">Karty</h2>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="bg-card text-card-foreground border-border space-y-2 rounded-lg border p-6">
            <h3 class="text-lg font-semibold">Card Title</h3>
            <p class="text-muted-foreground text-sm">
              This is a card using the new sage green theme. Notice the soft, natural colors.
            </p>
            <Button client:load size="sm">Card Action</Button>
          </div>
          <div class="bg-muted text-foreground space-y-2 rounded-lg p-6">
            <h3 class="text-lg font-semibold">Muted Card</h3>
            <p class="text-muted-foreground text-sm">A muted variant with slightly different background.</p>
            <Button client:load variant="secondary" size="sm">Secondary Action</Button>
          </div>
        </div>
      </div>

      <!-- Typography -->
      <div class="space-y-4">
        <h2 class="text-foreground text-2xl font-semibold">Typografia</h2>
        <div class="space-y-2">
          <p class="text-foreground">This is default foreground text.</p>
          <p class="text-muted-foreground">This is muted foreground text.</p>
          <p class="text-accent-foreground">This is accent foreground text.</p>
        </div>
      </div>

      <!-- Dark Mode Info -->
      <div class="space-y-4">
        <h2 class="text-foreground text-2xl font-semibold">Dark Mode</h2>
        <div class="bg-card text-card-foreground border-border space-y-3 rounded-lg border p-6">
          <p class="text-muted-foreground text-sm">
            Użyj przycisku w prawym górnym rogu aby przełączyć między trybem jasnym a ciemnym.
          </p>
          <div class="grid gap-4 text-sm md:grid-cols-2">
            <div>
              <p class="mb-1 font-semibold">Light Mode:</p>
              <ul class="text-muted-foreground space-y-1">
                <li>• Beżowo-kremowe tło</li>
                <li>• Sage green primary</li>
                <li>• Ciemny tekst</li>
              </ul>
            </div>
            <div>
              <p class="mb-1 font-semibold">Dark Mode:</p>
              <ul class="text-muted-foreground space-y-1">
                <li>• Ciemne szare tło</li>
                <li>• Sage green primary (taki sam)</li>
                <li>• Jasny tekst</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
