---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import AppSidebar from "@/components/AppSidebar.astro";
import { missingConfigs } from "@/lib/config-status";
import { getUserPlantCount } from "@/lib/plants";
import { createClient } from "@/lib/supabase";

interface Props {
  title?: string;
}

const { title = "Plant It" } = Astro.props;
const { user } = Astro.locals;
const currentPath = Astro.url.pathname;

let plantCount: number | null = null;

if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    plantCount = await getUserPlantCount(supabase, user.id);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/plant_it_.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body class="app-shell">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <AppSidebar userEmail={user?.email ?? null} currentPath={currentPath} plantCount={plantCount} />
    <main class="app-shell-main min-h-screen w-full">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  .app-shell-main {
    width: 100%;
    min-width: 0;
  }
</style>
