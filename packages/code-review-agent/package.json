{
  "name": "@plant-it/code-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scripted local code-review agent powered by Cursor SDK",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "review": "tsx src/review.ts",
    "validate-json": "tsx src/validate-review-json.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "dotenv": "^17.4.2",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
