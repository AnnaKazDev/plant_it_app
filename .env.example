# Node.js / Supabase CLI environment variables
# Copy this to .env and fill in real values
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=[anon-key-from-supabase-dashboard]
# Server-only — required for signup profile creation when email confirmation is enabled
SUPABASE_SERVICE_ROLE_KEY=[service-role-key-from-supabase-dashboard]
WEATHER_API_KEY=[your-weatherapi.com-key]

# Optional — npm run review (packages/code-review-agent, Cursor SDK)
# CURSOR_API_KEY=[from https://cursor.com/dashboard/api]
# CURSOR_MODEL=composer-2.5